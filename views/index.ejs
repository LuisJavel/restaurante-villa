<%- include('partials/header') %>

<main>
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-badge">✨ Cocina de Autor</span>
            <h1>Le Château</h1>
            <p>Una experiencia gastronómica extraordinaria donde la tradición francesa se encuentra con la innovación contemporánea</p>
            <div class="hero-buttons">
                <a href="/reservas" class="btn-primary">Reservar Mesa</a>
                <a href="/menu" class="btn-secondary">Ver Menú</a>
            </div>
        </div>
    </section>

    <section class="seccion">
        <h2 class="titulo-seccion">Nuestra Filosofía</h2>
        <p class="subtitulo-seccion">Cada plato cuenta una historia de pasión, tradición y excelencia culinaria</p>
        <div class="caracteristicas">
            <div class="caracteristica">
                <div class="caracteristica-icono">👨‍🍳</div>
                <h3>Cocina de Autor</h3>
                <p>Nuestros chefs crean platos únicos que combinan técnicas tradicionales con innovación contemporánea, ofreciendo una experiencia gastronómica sin igual.</p>
            </div>
            <div class="caracteristica">
                <div class="caracteristica-icono">🌿</div>
                <h3>Ingredientes Premium</h3>
                <p>Solo utilizamos ingredientes de la más alta calidad, seleccionados de proveedores locales y importados directamente para garantizar la frescura y excelencia.</p>
            </div>
            <div class="caracteristica">
                <div class="caracteristica-icono">✨</div>
                <h3>Ambiente Exclusivo</h3>
                <p>Un espacio elegante y acogedor diseñado para hacer de cada visita un momento especial e inolvidable con atención al más mínimo detalle.</p>
            </div>
        </div>
    </section>

    <section class="seccion">
        <h2 class="titulo-seccion">Platos Destacados</h2>
        <p class="subtitulo-seccion">Nuestras creaciones más premiadas que definen la esencia de Le Château</p>
        <img src="https://images.unsplash.com/photo-1544025162-d76694265947?w=1200&q=80" alt="Plato gourmet del chef" class="imagen-seccion">
        <div class="caracteristicas">
            <div class="caracteristica">
                <h3>Risotto de Hongos</h3>
                <p>Arroz arborio con hongos porcini, trufa negra y parmesano aged 24 meses. Un clásico reinventado con los mejores ingredientes.</p>
            </div>
            <div class="caracteristica">
                <h3>Corazón de Res</h3>
                <p>Wagyu A5 certificado con reducción de vino tinto y guarnición de vegetales de temporada. Pureza y sabor en cada bocado.</p>
            </div>
            <div class="caracteristica">
                <h3>Tarta Tatin</h3>
                <p>Clásico francés con manzanas caramelizadas y helado de vainilla bourbon. El postre perfecto para cerrar con broche de oro.</p>
            </div>
        </div>
    </section>

    <section class="seccion" style="text-align: center;">
        <h2 class="titulo-seccion">Visita Nuestra Galería</h2>
        <p class="subtitulo-seccion">Descubre los espacios que hacen de Le Château un lugar único</p>
        <a href="/galeria" class="btn-primary">Ver Galería</a>
    </section>
</main>

<%- include('partials/footer') %>
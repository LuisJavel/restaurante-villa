<%- include('partials/header') %>

<main>
    <section class="hero-page" style="--hero-bg: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?w=1920&q=80');">
        <div class="hero-page-overlay"></div>
        <div class="hero-page-content">
            <h1>Nuestro Menú</h1>
            <p>Creaciones exclusivas del Chef</p>
        </div>
    </section>

    <section class="seccion">
        <div class="menu-categoria" id="entradas">
            <div class="menu-header">
                <span class="menu-icon">🥂</span>
                <h2>Entradas</h2>
            </div>
            <div class="menu-list">
                <% menuItems.filter(item => item.categoria === 'entradas').forEach(item => { %>
                <div class="menu-list-item">
                    <div class="menu-list-img" onclick="expandImage('<%= item.imagen %>', '<%= item.nombre %>')">
                        <img src="<%= item.imagen %>" alt="<%= item.nombre %>">
                        <div class="img-zoom-icon">🔍</div>
                    </div>
                    <div class="menu-list-info">
                        <h4><%= item.nombre %></h4>
                        <p><%= item.descripcion %></p>
                    </div>
                    <span class="menu-list-precio">€<%= item.precio %></span>
                </div>
                <% }); %>
            </div>
            <% const entradasTotal = menuItems.filter(item => item.categoria === 'entradas').reduce((sum, item) => sum + item.precio, 0); %>
            <% if (entradasTotal > 0) { %>
            <div class="categoria-total">
                <span class="categoria-total-label">Total Entradas</span>
                <span class="categoria-total-value">€<%= entradasTotal %></span>
            </div>
            <% } %>
        </div>

        <div class="menu-categoria" id="principales">
            <div class="menu-header">
                <span class="menu-icon">🍽️</span>
                <h2>Platos Principales</h2>
            </div>
            <div class="menu-list">
                <% menuItems.filter(item => item.categoria === 'principales').forEach(item => { %>
                <div class="menu-list-item">
                    <div class="menu-list-img" onclick="expandImage('<%= item.imagen %>', '<%= item.nombre %>')">
                        <img src="<%= item.imagen %>" alt="<%= item.nombre %>">
                        <div class="img-zoom-icon">🔍</div>
                    </div>
                    <div class="menu-list-info">
                        <h4><%= item.nombre %></h4>
                        <p><%= item.descripcion %></p>
                    </div>
                    <span class="menu-list-precio">€<%= item.precio %></span>
                </div>
                <% }); %>
            </div>
            <% const principalesTotal = menuItems.filter(item => item.categoria === 'principales').reduce((sum, item) => sum + item.precio, 0); %>
            <% if (principalesTotal > 0) { %>
            <div class="categoria-total">
                <span class="categoria-total-label">Total Principales</span>
                <span class="categoria-total-value">€<%= principalesTotal %></span>
            </div>
            <% } %>
        </div>

        <div class="menu-categoria" id="postres">
            <div class="menu-header">
                <span class="menu-icon">🍰</span>
                <h2>Postres</h2>
            </div>
            <div class="menu-list">
                <% menuItems.filter(item => item.categoria === 'postres').forEach(item => { %>
                <div class="menu-list-item">
                    <div class="menu-list-img" onclick="expandImage('<%= item.imagen %>', '<%= item.nombre %>')">
                        <img src="<%= item.imagen %>" alt="<%= item.nombre %>">
                        <div class="img-zoom-icon">🔍</div>
                    </div>
                    <div class="menu-list-info">
                        <h4><%= item.nombre %></h4>
                        <p><%= item.descripcion %></p>
                    </div>
                    <span class="menu-list-precio">€<%= item.precio %></span>
                </div>
                <% }); %>
            </div>
            <% const postresTotal = menuItems.filter(item => item.categoria === 'postres').reduce((sum, item) => sum + item.precio, 0); %>
            <% if (postresTotal > 0) { %>
            <div class="categoria-total">
                <span class="categoria-total-label">Total Postres</span>
                <span class="categoria-total-value">€<%= postresTotal %></span>
            </div>
            <% } %>
        </div>

        <% const totalMenu = menuItems.reduce((sum, item) => sum + item.precio, 0); %>
        <div class="menu-grand-total">
            <div class="grand-total-inner">
                <span class="grand-total-label">Valor Total del Menú</span>
                <span class="grand-total-value">€<%= totalMenu %></span>
            </div>
        </div>
    </section>
</main>

<div class="modal-overlay" id="imageModal">
    <div class="modal" style="max-width: 800px;">
        <div class="modal-header">
            <h2 class="modal-title" id="imageModalTitle">Vista de Imagen</h2>
            <button class="modal-close" onclick="closeImageModal()">✕</button>
        </div>
        <div class="modal-body" style="padding: 0;">
            <img id="expandedImage" src="" alt="Imagen ampliada" style="width: 100%; max-height: 70vh; object-fit: contain; border-radius: 0 0 var(--radius) var(--radius);">
        </div>
    </div>
</div>

<style>
.hero-mini {
    position: relative;
    height: 35vh;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
}

.hero-mini-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #312e81 100%);
}

.hero-mini-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?w=1200&q=80') center/cover;
    opacity: 0.25;
}

.hero-mini-content {
    position: relative;
    z-index: 1;
    padding: 2rem;
}

.hero-mini-content h1 {
    font-family: var(--font-heading);
    font-size: 3rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff 0%, #e0e7ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-mini-content p {
    color: #cbd5e1;
    font-size: 1.1rem;
}

.menu-categoria {
    margin-bottom: 4rem;
}

.menu-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-border);
}

.menu-icon {
    font-size: 2rem;
}

.menu-header h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--color-primary);
    font-weight: 600;
}

.menu-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.menu-list-item {
    background: var(--color-card);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border: 1px solid var(--color-border);
    transition: all 0.3s;
    cursor: default;
}

.menu-list-item:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    border-color: var(--color-accent-light);
}

.menu-list-img {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    cursor: zoom-in;
}

.menu-list-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}

.menu-list-img:hover img {
    transform: scale(1.1);
}

.img-zoom-icon {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
}

.menu-list-img:hover .img-zoom-icon {
    opacity: 1;
}

.menu-list-info {
    flex: 1;
}

.menu-list-info h4 {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
}

.menu-list-info p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.6;
}

.menu-list-precio {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-accent);
    font-weight: 600;
    flex-shrink: 0;
}

.categoria-total {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1rem;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, var(--color-accent-light), #ddd6fe);
    border-radius: var(--radius);
}

.categoria-total-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary);
}

.categoria-total-value {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
}

.menu-grand-total {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: var(--radius);
    padding: 2rem;
    margin-top: 2rem;
}

.grand-total-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 600px;
    margin: 0 auto;
}

.grand-total-label {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: white;
}

.grand-total-value {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #fff, #e0e7ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 1rem;
}

.modal-overlay.active {
    display: flex;
}

.modal {
    background: var(--color-card);
    border-radius: var(--radius);
    width: 100%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-primary);
}

.modal-close {
    width: 36px;
    height: 36px;
    border: none;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-close:hover {
    background: var(--color-danger);
    color: white;
}

@media (max-width: 768px) {
    .menu-list-item {
        flex-direction: column;
        text-align: center;
    }

    .menu-list-img {
        width: 150px;
        height: 150px;
    }

    .menu-list-precio {
        font-size: 1.75rem;
    }
}
</style>

<script>
function expandImage(url, nombre) {
    document.getElementById('expandedImage').src = url;
    document.getElementById('imageModalTitle').textContent = nombre;
    document.getElementById('imageModal').classList.add('active');
}

function closeImageModal() {
    document.getElementById('imageModal').classList.remove('active');
}

document.getElementById('imageModal').addEventListener('click', (e) => {
    if (e.target.id === 'imageModal') closeImageModal();
});

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeImageModal();
});
</script>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<main>
    <section class="hero-page" style="--hero-bg: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1920&q=80');">
        <div class="hero-page-overlay"></div>
        <div class="hero-page-content">
            <h1>Reservaciones</h1>
            <p>Reserve su mesa para una experiencia inolvidable</p>
        </div>
    </section>

    <section class="seccion">
        <div class="reservas-container">
            <div class="reservas-info">
                <h3>¿Por qué reservar?</h3>
                <ul class="reservas-beneficios">
                    <li>
                        <span class="beneficio-icon">✓</span>
                        <span>Mesa garantizada en el horario que prefiera</span>
                    </li>
                    <li>
                        <span class="beneficio-icon">✓</span>
                        <span>Menú especial para ocasiones especiales</span>
                    </li>
                    <li>
                        <span class="beneficio-icon">✓</span>
                        <span>Servicio personalizado de nuestro sommelier</span>
                    </li>
                    <li>
                        <span class="beneficio-icon">✓</span>
                        <span>Confirmación inmediata por WhatsApp</span>
                    </li>
                </ul>

                <div class="reservas-horario">
                    <h4>🕐 Horario del Restaurante</h4>
                    <p>Martes - Sábado: 19:00 - 23:00</p>
                    <p>Domingo: 13:00 - 22:00</p>
                    <p>Lunes: Cerrado</p>
                </div>
            </div>

            <div class="form-card">
                <h3>Formulario de Reserva</h3>
                <form id="formReserva" class="formulario">
                    <div class="form-grupo">
                        <label for="nombre">Nombre completo</label>
                        <input type="text" id="nombre" name="nombre" placeholder="Ej: Juan García" required>
                    </div>
                    <div class="form-grupo">
                        <label for="telefono">Teléfono</label>
                        <input type="tel" id="telefono" name="telefono" placeholder="Ej: +34 612 345 678" required>
                    </div>
                    <div class="form-row">
                        <div class="form-grupo">
                            <label for="fecha">Fecha</label>
                            <input type="date" id="fecha" name="fecha" required>
                        </div>
                        <div class="form-grupo">
                            <label for="hora">Hora</label>
                            <select id="hora" name="hora" required>
                                <option value="">Seleccione</option>
                                <option value="19:00">19:00</option>
                                <option value="19:30">19:30</option>
                                <option value="20:00">20:00</option>
                                <option value="20:30">20:30</option>
                                <option value="21:00">21:00</option>
                                <option value="21:30">21:30</option>
                                <option value="22:00">22:00</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grupo">
                        <label for="personas">Número de personas</label>
                        <select id="personas" name="personas" required>
                            <option value="">¿Cuántos serán?</option>
                            <option value="1">1 persona</option>
                            <option value="2">2 personas</option>
                            <option value="3">3 personas</option>
                            <option value="4">4 personas</option>
                            <option value="5">5 personas</option>
                            <option value="6">6 personas</option>
                            <option value="7">7 personas</option>
                            <option value="8">8+ personas (grupo)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary btn-block">Confirmar Reserva</button>
                </form>

                <div id="mensajeExito" class="mensaje-exito oculto">
                    <div class="mensaje-icono">✓</div>
                    <h4>¡Reserva Enviada!</h4>
                    <p>Nos pondremos en contacto pronto para confirmar su reserva.</p>
                </div>
                <div id="mensajeError" class="mensaje-error oculto">
                    <div class="mensaje-icono error">✕</div>
                    <h4>No Disponible</h4>
                    <p id="errorMessage"></p>
                </div>
            </div>
        </div>
    </section>
</main>

<style>
.hero-mini {
    position: relative;
    height: 35vh;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
}

.hero-mini-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #312e81 100%);
}

.hero-mini-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200&q=80') center/cover;
    opacity: 0.25;
}

.hero-mini-content {
    position: relative;
    z-index: 1;
    padding: 2rem;
}

.hero-mini-content h1 {
    font-family: var(--font-heading);
    font-size: 3rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff 0%, #e0e7ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-mini-content p {
    color: #cbd5e1;
    font-size: 1.1rem;
}

.reservas-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
}

.reservas-info h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
}

.reservas-beneficios {
    list-style: none;
    margin-bottom: 2.5rem;
}

.reservas-beneficios li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
}

.beneficio-icon {
    width: 24px;
    height: 24px;
    background: var(--color-success);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
}

.reservas-horario {
    background: var(--color-accent-light);
    padding: 1.5rem;
    border-radius: var(--radius);
}

.reservas-horario h4 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
}

.reservas-horario p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
}

.form-card {
    background: var(--color-card);
    border-radius: var(--radius);
    padding: 2rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
}

.form-card h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    text-align: center;
}

.formulario {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.form-grupo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-grupo label {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9rem;
}

.form-grupo input,
.form-grupo select {
    padding: 0.875rem 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.2s;
    background: var(--color-bg);
}

.form-grupo input:focus,
.form-grupo select:focus {
    outline: none;
    border-color: var(--color-accent);
    background: white;
    box-shadow: 0 0 0 4px var(--color-accent-light);
}

.btn-block {
    width: 100%;
    justify-content: center;
    margin-top: 0.5rem;
}

.mensaje-exito {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    border-radius: var(--radius);
    margin-top: 1rem;
}

.mensaje-icono {
    width: 60px;
    height: 60px;
    background: var(--color-success);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 1rem;
}

.mensaje-exito h4 {
    color: #166534;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.mensaje-exito p {
    color: #15803d;
}

.mensaje-error {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    border-radius: var(--radius);
    margin-top: 1rem;
}

.mensaje-error .mensaje-icono {
    background: var(--color-danger);
}

.mensaje-error h4 {
    color: #991b1b;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
}

.mensaje-error p {
    color: #b91c1c;
}

.oculto {
    display: none;
}

@media (max-width: 900px) {
    .reservas-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .form-row {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
let diasEspeciales = [];

async function loadDiasEspeciales() {
    const res = await fetch('/api/dias-especiales');
    diasEspeciales = await res.json();
    blockClosedDays();
}

function blockClosedDays() {
    const fechaInput = document.getElementById('fecha');
    const closedDates = diasEspeciales.filter(d => d.cerrado).map(d => d.fecha);

    fechaInput.addEventListener('input', () => {
        const selectedDate = fechaInput.value;
        const closedDay = diasEspeciales.find(d => d.fecha === selectedDate && d.cerrado);

        if (closedDay) {
            document.getElementById('errorMessage').textContent = closedDay.titulo + ': ' + (closedDay.descripcion || 'No hay servicio este día');
            document.getElementById('mensajeError').classList.remove('oculto');
            document.getElementById('mensajeExito').classList.add('oculto');
        } else {
            document.getElementById('mensajeError').classList.add('oculto');
        }
    });
}

document.getElementById('formReserva').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = {
        nombre: form.nombre.value,
        telefono: form.telefono.value,
        fecha: form.fecha.value,
        hora: form.hora.value,
        personas: form.personas.value
    };

    try {
        const res = await fetch('/api/reservas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
            form.style.display = 'none';
            document.getElementById('mensajeError').classList.add('oculto');
            document.getElementById('mensajeExito').classList.remove('oculto');
        } else {
            document.getElementById('errorMessage').textContent = result.error || 'No se pudo completar la reserva';
            document.getElementById('mensajeError').classList.remove('oculto');
            document.getElementById('mensajeExito').classList.add('oculto');
        }
    } catch (err) {
        alert('Error al enviar la reserva');
    }
});

loadDiasEspeciales();
</script>

<%- include('partials/footer') %>